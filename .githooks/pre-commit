#!/usr/bin/env bash
# Puerta rápida antes de cada commit: cadenas prohibidas y pruebas del núcleo.
# Lo lento (web, compilación) va en pre-push. Saltar puntualmente: --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

# El gancho global de ~/.config/git/hooks bloquea .env y claves privadas.
# core.hooksPath lo sustituye, así que se llama a mano o se pierde esa red.
GLOBAL="$(git config --global --get core.hooksPath || true)"
[ -n "$GLOBAL" ] && [ -x "$GLOBAL/pre-commit" ] && "$GLOBAL/pre-commit"

npm run test:rapido
