{
  "name": "@edumind-hilo/web",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "description": "EDUmind Hilo, PWA: portal del docente y pantalla del alumnado.",
  "author": "Luis Vilela Acuña <contacto@edumind.es>",
  "license": "(AGPL-3.0-or-later OR EUPL-1.2)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prebuild": "node ../../scripts/guardia-dist.mjs",
    "nativo:compilar": "vite build --outDir dist-nativo --emptyOutDir",
    "nativo:sync": "npm run nativo:compilar && cap sync",
    "nativo:android": "npm run nativo:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@edumind-hilo/nucleo": "*",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
